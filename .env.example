# Bybit API Credentials (configured in Northflank Environment Variables)
PORT=8000
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=false

# MongoDB Addon Connection (optional - automatically set if linked to Northflank Mongo addon)
MONGODB_URI=mongodb://username:password@your-northflank-mongo-host:27017/gridmaker?authSource=admin

